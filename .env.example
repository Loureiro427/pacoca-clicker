VITE_PACOCA_API_URL=https://api.pacoca.net/api
VITE_PACOCA_FRONTEND_URL=https://pacoca.net
VITE_PACOCA_CDN_URL=https://cdn.pacoca.net/pacoca-prod-files


# Suporte usa POST /clicker/reports. O webhook deve existir somente no servidor.

# Publicidade: use a mesma configuração do frontend com o prefixo VITE_.
# O banner é exibido nas listas da Loja e de Melhorias somente quando uma
# configuração válida estiver disponível. Não inclua chaves reais neste arquivo.
VITE_FEED_AD_PROVIDER=adsterra
VITE_ADSTERRA_FEED_ZONE_KEY=
VITE_ADSTERRA_FEED_SCRIPT_URL=
VITE_ADSTERRA_FEED_WIDTH=300
VITE_ADSTERRA_FEED_HEIGHT=250

# Alternativa ao Adsterra. Preencha somente se VITE_FEED_AD_PROVIDER=google.
VITE_GOOGLE_ADSENSE_CLIENT=
VITE_GOOGLE_ADSENSE_FEED_SLOT=
